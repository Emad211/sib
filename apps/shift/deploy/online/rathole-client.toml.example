# Clinic PC (O05): opens the tunnel outward, so the clinic needs no open port and no fixed IP.
# Copy to <home>/tunnel/client.toml; the token and the server's public key come from the VPS setup.
[client]
remote_addr = "RELAY_IP_OR_NAME:2333"
default_token = "REPLACE_WITH_THE_SHARED_TOKEN"
retry_interval = 5

[client.transport]
type = "noise"

[client.transport.noise]
remote_public_key = "REPLACE_WITH_THE_SERVER_PUBLIC_KEY"

[client.services.shift]
local_addr = "127.0.0.1:8443"         # serve_lan.py's HTTPS port; TLS ends here, on the clinic PC
